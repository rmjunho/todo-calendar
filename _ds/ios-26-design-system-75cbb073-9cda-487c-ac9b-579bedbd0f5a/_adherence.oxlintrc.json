{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/controls/**",
              "components/foundation/**",
              "components/overlays/**",
              "components/pickers/**",
              "ui_kits/ios/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='SheetAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|role|onPress|key|ref|className|style|children)$/]",
        "message": "<SheetAction> doesn't accept that prop. Declared props: label, role, onPress."
      },
      {
        "selector": "JSXOpeningElement[name.name='SheetAction'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:default|cancel|destructive)$/]",
        "message": "<SheetAction> role must be one of 'default' | 'cancel' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|role|onPress|key|ref|className|style|children)$/]",
        "message": "<AlertAction> doesn't accept that prop. Declared props: label, role, onPress."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertAction'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:default|cancel|destructive)$/]",
        "message": "<AlertAction> role must be one of 'default' | 'cancel' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|shape|tint|icon|iconTrailing|iconOnly|fullWidth|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, shape, tint, icon, iconTrailing, iconOnly, fullWidth, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:prominent|tinted|gray|plain|glass)$/]",
        "message": "<Button> variant must be one of 'prominent' | 'tinted' | 'gray' | 'plain' | 'glass'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|medium|large)$/]",
        "message": "<Button> size must be one of 'small' | 'medium' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:capsule|rounded|circle)$/]",
        "message": "<Button> shape must be one of 'capsule' | 'rounded' | 'circle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColorPicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|opacity|onOpacityChange|onClose|style|key|ref|className|style|children)$/]",
        "message": "<ColorPicker> doesn't accept that prop. Declared props: value, onChange, opacity, onOpacityChange, onClose, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|weight|color|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, weight, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='weight'] > Literal[value!=/^(?:light|regular|semibold|bold)$/]",
        "message": "<Icon> weight must be one of 'light' | 'regular' | 'semibold' | 'bold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PickerOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<PickerOption> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|tint|size|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, disabled, tint, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|medium)$/]",
        "message": "<Switch> size must be one of 'small' | 'medium'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
