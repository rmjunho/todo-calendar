rules_version = '2';

// 배포: firebase deploy --only firestore:rules
//   firebase.json 의 "rules": "firestore.rules" 가 이 파일을 가리킨다.
//   콘솔(Firestore Database → 규칙)에 붙여넣어도 되지만, 한 조각만 끼우면 match 중첩이
//   어긋나도 "게시" 직전까지 안 보인다 — 콘솔로 할 때는 전체를 갈아 끼울 것.
// ⚠️ 배포 순서는 변경 성격에 따라 갈린다 (CONTEXT.md §0). 새 필드를 *요구*하는 규칙은
//    코드를 먼저, 권한을 *추가*만 하는 규칙은 규칙을 먼저.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // 내 계정 문서 경로. exists() 와 get() 이 반드시 같은 경로를 보도록 한 곳에 둔다.
    function myDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    // ⚠️ get() 은 문서가 없으면 null 을 돌려주고, 거기서 .data 를 읽으면 규칙 평가가
    // 오류로 끝난다 — false 가 아니라 오류라서 || 의 오른쪽으로 넘어가지도 않는다.
    // 탈퇴처럼 내 계정 문서가 사라지는 흐름에서 이 차이가 드러나므로, me() 를 쓰는
    // 함수는 전부 hasProfile() 로 존재를 먼저 확인한다.
    function hasProfile() {
      return signedIn() && exists(myDoc());
    }
    function me() {
      return get(myDoc()).data;
    }
    function approved() {
      return hasProfile() && me().status == 'approved';
    }
    function isAdmin() {
      return hasProfile() && me().status == 'approved' && me().role == 'admin';
    }
    // 화면 설정(테마·언어·첫 화면). 값을 여기서 좁혀 두지 않으면 users 문서가 임의의
    // 맵을 받는 통로가 된다 — 키 목록과 값 집합을 둘 다 고정한다.
    // ★ 키를 늘릴 때는 i18n.js 의 검증 함수(okTheme/okLang/okView)와 **같은 집합**을
    //   유지할 것. 어긋나면 화면은 멀쩡한데 저장만 조용히 거부된다.
    function validSettings(s) {
      return s.keys().hasOnly(['theme', 'lang', 'view'])
             && s.theme in ['light', 'dark', 'system']
             && s.lang in ['ko', 'en']
             && s.view in ['year', 'month', 'week', 'day'];
    }

    // 로그인 전에 이름 → 이메일을 찾기 위한 색인.
    // get 만 열고 list 는 막는다 — 안 그러면 전체 이름·이메일을 통째로 긁어간다.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      // 가입할 때 본인 것만 만든다. 이름 선점을 되돌리거나 남의 것을 가로챌 수 없다.
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'email']);
      allow update: if false;
      // 계정 삭제 때만. 이름 선점을 풀어 주는 통로이기도 하다.
      //
      // 본인 검사를 왼쪽에 둔다. || 는 왼쪽부터 평가하는데, 이쪽은 문서를 더 읽지
      // 않고 resource 만 보므로 본인 탈퇴가 isAdmin() 을 아예 거치지 않는다.
      // 내 users 문서가 이미 없는 고아 정리 상황에서도 이 경로는 살아 있다.
      allow delete: if resource.data.uid == request.auth.uid || isAdmin();
    }

    match /users/{uid} {
      // 본인 문서 읽기는 승인 여부와 무관하게 허용한다. 승인 대기 중인 사람이
      // 자기 status 를 확인할 방법이 이것뿐이다. 노출되는 건 자기 이름·이메일·
      // 상태뿐이고 남의 정보는 없다.
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // 가입 직후엔 아직 pending 이라 approved 검사를 통과할 수 없다.
      // 스스로 admin 이나 approved 를 달고 태어나지 못하게 값을 고정한다.
      //
      // 필수 동의는 여기서 강제한다 — 화면 검사는 콘솔에서 우회할 수 있어도
      // 이건 못 한다. 조건이 깨지면 문서가 아예 생기지 않고, signUp() 의 catch 가
      // 짝 없는 Auth 계정을 로그아웃시킨다.
      //
      // 이 조건은 create 에만 걸린다. 약관 도입 전에 가입한 계정은 agreements 가
      // 없지만 get / update / todos 규칙은 그대로라서 로그인에 지장이 없다.
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.role == 'user'
                    && request.resource.data.agreements.terms.agreed == true
                    && request.resource.data.agreements.privacy.agreed == true
                    && request.resource.data.agreements.age in ['over14', 'under14_guardian'];

      // 두 갈래를 일부러 분리한다. 한 조건으로 합쳐서 hasOnly(['status','settings'])
      // 로 풀면 관리자가 남의 화면 설정까지 바꿀 수 있게 된다.
      //
      // 1) 관리자는 남의 status 만. settings 는 못 건드린다.
      // 2) 본인은 자기 settings 만. status·role·agreements 는 못 건드린다.
      //
      // 관리자가 자기 문서를 고칠 때는 2번으로 통과한다(uid == uid). 1번은
      // hasOnly(['status']) 라 settings 가 섞이는 순간 막히므로 교차 오염이 없다.
      allow update: if (isAdmin()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                        && request.resource.data.status in ['pending', 'approved', 'rejected'])
                    || (request.auth.uid == uid
                        && approved()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settings'])
                        && validSettings(request.resource.data.settings));
      // 관리자만 계정을 완전히 지운다. 자기 자신은 못 지운다 — 관리자가 자기
      // users 문서를 날리면 isAdmin() 이 거짓이 되어 스스로 잠긴다. 화면에서도
      // 버튼을 감추지만, 콘솔로 우회하는 발등까지 여기서 막는다.
      // 남을 지우는 건 관리자만. 본인 탈퇴는 관리자가 아닐 때만.
      //
      // 관리자가 자기 문서를 지우면 isAdmin() 이 거짓이 되어 남은 회원을 아무도
      // 관리하지 못하는 상태로 잠긴다. 화면에서도 버튼을 감추지만 진짜 방어선은
      // 여기다 — 관리자를 넘기려면 콘솔에서 다른 계정의 role 을 먼저 올릴 것.
      allow delete: if (request.auth.uid == uid && hasProfile() && me().role != 'admin')
                    || (isAdmin() && request.auth.uid != uid);

      // 카테고리. 할 일과 같은 자리·같은 권한이다.
      //
      // 할 일과 달리 필드를 좁혀 둔다. 이유는 색이 화면과 캔버스에 **문자열 그대로**
      // 들어가기 때문이다 — pill()·일간 블록은 style="background:…" 안에 esc() 없이
      // 넣으므로 큰따옴표 하나로 속성을 탈출할 수 있고, 캔버스 fillStyle 은 파싱 못
      // 하는 값을 조용히 무시해서 색만 틀린 PNG 를 낸다. 집합으로 고정하면 둘 다
      // 원리적으로 사라진다. ★ calendar.js 의 CAT_COLORS 와 같은 집합을 유지할 것.
      //
      // 개수 상한은 여기서 못 건다 — 규칙에 집계가 없어 컬렉션 문서 수를 셀 수 없다.
      // 화면(CAT_MAX)에서만 막는다. 카운터 문서 + 트랜잭션은 개인용 앱에 과하다.
      function catColor(c) {
        return c in ['#FF3B30', '#FF9500', '#34C759', '#00C7BE', '#30B0C7',
                     '#007AFF', '#5856D6', '#AF52DE', '#FF2D55', '#A2845E'];
      }
      function validCat(d) {
        return d.keys().hasOnly(['name', 'color'])
               && d.name is string && d.name.size() > 0 && d.name.size() <= 20
               && catColor(d.color);
      }
      match /categories/{catId} {
        allow read, delete: if signedIn() && request.auth.uid == uid && approved();
        allow create, update: if signedIn() && request.auth.uid == uid && approved()
                              && validCat(request.resource.data);
        // todos 와 같은 이유로 관리자에게 연다 — 계정을 지울 때 서브컬렉션을 직접
        // 훑어야 하는데 id 조회(list)가 곧 내용 조회라 read 없이 delete 만 줄 수 없다.
        // ponytail: 관리자가 남의 카테고리 **이름**을 읽게 된다. 처리방침 7항의
        // 관리자 접근 범위에 이 한 줄이 늘어난다 — 규칙을 조이거나 풀면 문구도 함께.
        allow read, delete: if isAdmin();
      }

      // 목표(버킷리스트). 할 일과 **다른 컬렉션**이다 — 목표는 날짜 하나가 아니라
      // 기간(그 해 안 / 그 달까지)이라서 occursOn 의 '한 항목 = 한 날' 전제에 안 맞는다.
      // 섞으면 모든 렌더 경로가 목표를 걸러내야 하고, 한 곳만 빠뜨리면 목표가 365일
      // 전부에 뜬다. 따로 두면 할 일 로직을 한 줄도 안 건드린다.
      //
      // 검증은 categories 보다 얕다. 색처럼 style/캔버스에 문자열로 들어가는 값이 없고
      // 제목·메모는 todos 와 같이 esc() 를 지난다. 그래서 **키 목록**(임의 맵 방지)과
      // 코드가 분기하는 **scope** 만 본다.
      function validGoal(d) {
        return d.keys().hasOnly(['title', 'scope', 'y', 'm', 'd', 'categoryId', 'memo', 'done'])
               && d.title is string && d.title.size() > 0 && d.title.size() <= 100
               && d.scope in ['year', 'month']
               && d.y is int
               && d.done is bool;
      }
      match /goals/{goalId} {
        allow read, delete: if signedIn() && request.auth.uid == uid && approved();
        allow create, update: if signedIn() && request.auth.uid == uid && approved()
                              && validGoal(request.resource.data);
        // todos·categories 와 같은 이유 — 계정 삭제 때 서브컬렉션을 직접 훑어야 하는데
        // id 조회(list)가 곧 내용 조회라 read 없이 delete 만 줄 수 없다.
        allow read, delete: if isAdmin();
      }

      // 할 일은 본인 것만, 승인된 뒤에만.
      match /todos/{todoId} {
        allow read, write: if signedIn() && request.auth.uid == uid && approved();
        // 계정 삭제 때문에 관리자에게 열어 준다. 서브컬렉션은 부모를 지워도 남고,
        // 클라이언트 SDK 는 문서 id 를 알아야 지울 수 있는데 id 조회(list)가 곧
        // 내용 조회다 — 그래서 read 없이 delete 만 주는 방법이 없다.
        //
        // ponytail: 관리자가 남의 할 일을 읽을 수 있게 된다. 이걸 막으려면
        // Admin SDK 를 쓰는 Cloud Function 으로 삭제를 옮겨야 한다. 관리자가
        // 본인 한 명뿐인 지금은 함수를 띄울 값어치가 없다고 보고 열어 뒀다.
        allow read, delete: if isAdmin();
      }
    }
  }
}
